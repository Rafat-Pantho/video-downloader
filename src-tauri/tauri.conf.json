{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video Downloader",
  "version": "2.0.0",
  "identifier": "com.videodownloader.app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run webpack",
    "beforeBuildCommand": "npm run webpack"
  },
  "app": {
    "windows": [
      {
        "title": "Video Downloader",
        "width": 900,
        "height": 700,
        "minWidth": 700,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis",
      "app",
      "dmg"
    ],
    "resources": {
      "../bin/*": "bin/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      },
      "rpm": {
        "depends": []
      }
    }
  }
}
